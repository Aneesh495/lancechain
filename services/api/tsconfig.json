{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@lancechain/sdk": ["../../packages/sdk/dist/src/index.d.ts"],
      "@lancechain/indexer": ["../indexer/dist/src/index.d.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
